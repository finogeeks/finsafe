{
  "name": "@finogeeks2026/finshield-opencode",
  "version": "0.11.55",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.rtf",
  "description": "FinShield protection for the native OpenCode desktop backend",
  "keywords": [
    "opencode-plugin",
    "opencode",
    "finshield",
    "windows",
    "appcontainer",
    "security"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finogeeks/finsafe.git",
    "directory": "integrations/opencode/windows"
  },
  "homepage": "https://github.com/finogeeks/finsafe/blob/main/integrations/opencode/windows/README.md",
  "bugs": {
    "url": "https://github.com/finogeeks/finsafe/issues"
  },
  "exports": {
    ".": "./src/index.js",
    "./gui-experimental": "./dist/gui-experimental.cjs"
  },
  "files": [
    "src",
    "dist",
    "updater",
    "policy",
    "LICENSE.rtf",
    "release.json",
    "THIRD-PARTY-NOTICES.md",
    "README.md",
    "DESIGN.md",
    "install",
    "ui"
  ],
  "scripts": {
    "build": "vite build && node build-updater.mjs",
    "build:policy": "finsafe config resolve --manifest ../../../windows/config/opencode-plugin/manifest.yaml --output policy/candidate.yaml",
    "pretest": "node ../../common/windows/build.mjs .",
    "test": "node --test test/*.test.js",
    "prepack": "npm run build"
  },
  "dependencies": {
    "@finogeeks2026/finsafe-sdk": "0.11.55"
  },
  "devDependencies": {
    "@opencode/plugin": "2.3.0",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "effect": "4.1.0",
    "esbuild": "0.25.12",
    "solid-js": "1.9.19",
    "vite": "7.3.8",
    "vite-plugin-solid": "2.11.9"
  },
  "bundleDependencies": [
    "@finogeeks2026/finsafe-sdk"
  ]
}
