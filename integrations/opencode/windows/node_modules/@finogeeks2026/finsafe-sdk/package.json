{
  "name": "@finogeeks2026/finsafe-sdk",
  "version": "0.11.65",
  "type": "module",
  "license": "SEE LICENSE IN LICENSE.rtf",
  "description": "Node call wrappers for existing FinSAFE native operations",
  "exports": {
    ".": "./src/native.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE.rtf",
    "bin/finsafe_native.dll",
    "release.json",
    "native-build.json"
  ],
  "scripts": {
    "test": "node --test test/*.test.js",
    "prepack": "node -e \"require('node:fs').accessSync('bin/finsafe_native.dll')\""
  },
  "engines": {
    "node": ">=24.9.0"
  },
  "dependencies": {
    "koffi": "3.1.1"
  },
  "optionalDependencies": {
    "@koromix/koffi-win32-x64": "3.1.1"
  },
  "bundleDependencies": [
    "koffi",
    "@koromix/koffi-win32-x64"
  ]
}
