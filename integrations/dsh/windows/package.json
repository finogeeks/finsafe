{
  "name": "@finogeeks2026/finshield",
  "version": "0.10.51",
  "description": "Harness intelligence · Shield your world",
  "homepage": "https://safety.finaios.ai/",
  "icon": "./assets/finshield.png",
  "license": "SEE LICENSE IN LICENSE.rtf",
  "type": "module",
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "main": "./src/desktop.js",
  "exports": {
    ".": "./src/desktop.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json"
  },
  "files": [
    "src/desktop.js",
    "src/settings.js",
    "src/status.js",
    "src/contract.js",
    "client.js",
    "assets/finshield.png",
    "policy/candidate.yaml",
    "install",
    "src/token.js",
    "locale",
    "detail",
    "cordis.patch.yml",
    "README.md",
    "README-zh.md",
    "OPERATIONS.md",
    "OPERATIONS-zh.md",
    "src/connector.js",
    "client/page.cjs",
    "build-client.mjs",
    "DESIGN.md",
    "LICENSE.rtf",
    "THIRD-PARTY-NOTICES.md",
    "src/preparation.js",
    "client/state.cjs",
    "src/activation.js",
    "src/self-update.js",
    "src/removal.js",
    "updater",
    "bin"
  ],
  "engines": {
    "node": ">=24.9.0",
    "dsh": ">=0.2.1-rc.5 <0.3.0"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml",
      "platforms": [
        "win32"
      ]
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-plugin-manager",
        "@deepseek-ai/dsh-api-remotes",
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/schemastery": "~3.18.5"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/finogeeks/finsafe.git",
    "directory": "integrations/dsh/windows"
  },
  "scripts": {
    "build:policy": "finsafe config resolve --manifest ../../../windows/config/dsh-plugin/manifest.yaml --output policy/candidate.yaml",
    "build": "node build-client.mjs",
    "test": "node --test test/*.test.js",
    "build:native": "python build-native.py",
    "build:pnpm-parser": "node build-pnpm-parser.mjs"
  },
  "devDependencies": {
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "@pnpm/modules-yaml": "1002.0.1",
    "esbuild": "0.25.12"
  }
}
